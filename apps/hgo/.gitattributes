* text=auto eol=lf
# Transport hashes require identical bytes on Windows and Linux.
assets/**/*.json text eol=lf
assets/**/*.gz binary
# Overlay manifests hash exact generated bytes, including review/provenance JSON.
# Preserve their existing line endings on every platform; retain textual diffs.
assets/overlays/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
