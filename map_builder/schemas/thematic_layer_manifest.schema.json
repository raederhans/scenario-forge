{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://thematic/layer_manifest/v1",
  "type": "object",
  "required": [
    "schema_version",
    "layer_id",
    "theme",
    "title",
    "description",
    "geometry_kind",
    "metric_ids",
    "period",
    "coverage_scope",
    "source_policy",
    "status",
    "paths",
    "provenance",
    "license",
    "normalization",
    "feature_counts",
    "build_audit_path",
    "generated_at",
    "build_command",
    "runtime_consumer",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "layer_id": {
      "type": "string",
      "pattern": "^[a-z0-9_:-]+$"
    },
    "theme": {
      "enum": [
        "political",
        "economic",
        "social",
        "population",
        "conflict",
        "security",
        "energy",
        "food",
        "water",
        "migration",
        "ideology",
        "heritage"
      ]
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "geometry_kind": {
      "enum": ["admin0", "admin1", "admin2", "grid_720x360", "point_event", "network_line"]
    },
    "metric_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_:-]+$"
      },
      "uniqueItems": true
    },
    "period": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "enum": ["year", "range", "epoch", "fixture"]
        },
        "year": {
          "type": "integer"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "coverage_scope": {
      "type": "object",
      "required": ["geography_level", "join_key_type", "feature_count"],
      "properties": {
        "geography_level": {
          "enum": ["admin0", "admin1", "admin2", "grid"]
        },
        "join_key_type": {
          "enum": ["iso_a3", "iso_3166_2", "grid_cell"]
        },
        "feature_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "source_policy": {
      "enum": ["fixture_only", "manual_seed", "real_source_cache_only", "external_download_supported"]
    },
    "status": {
      "enum": ["fixture", "demo", "experimental", "ready"]
    },
    "paths": {
      "type": "object",
      "required": ["build_audit", "source_recipes"],
      "properties": {
        "metrics": {
          "type": "string",
          "pattern": "^data/thematic_layers/.+\\.json$"
        },
        "grid": {
          "type": "string",
          "pattern": "^data/thematic_layers/.+\\.json$"
        },
        "build_audit": {
          "type": "string",
          "pattern": "^data/thematic_layers/.+/build_audit\\.json$"
        },
        "source_recipes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^data/thematic_layers/source_recipes/.+\\.json$"
          }
        }
      },
      "oneOf": [
        {"required": ["metrics"]},
        {"required": ["grid"]}
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "name", "url", "release", "license", "citation", "selection_rule"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_:-]+$"
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "release": {
            "type": "string",
            "pattern": "\\S"
          },
          "published_at": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "pattern": "\\S"
          },
          "citation": {
            "type": "string",
            "pattern": "\\S"
          },
          "selection_rule": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    },
    "license": {
      "type": "object",
      "required": ["fixture_data", "source_metadata"],
      "properties": {
        "fixture_data": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_metadata": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "normalization": {
      "type": "object",
      "required": ["method", "range"],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "\\S"
        },
        "range": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        }
      },
      "additionalProperties": true
    },
    "feature_counts": {
      "type": "object",
      "required": ["features", "complete", "partial", "missing"],
      "properties": {
        "features": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "build_audit_path": {
      "type": "string",
      "pattern": "^data/thematic_layers/.+/build_audit\\.json$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "\\S"
    },
    "build_command": {
      "type": "string",
      "pattern": "\\S"
    },
    "runtime_consumer": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["not_wired", "catalog_only", "runtime_ready", "main_map_ready"]
        },
        "supported_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "supported_scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        }
      },
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": false
}
