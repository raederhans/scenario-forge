{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://quick_fill/china_reference/v1",
  "title": "Pinned administrative code reference, not boundary geometry",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/unit"
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
